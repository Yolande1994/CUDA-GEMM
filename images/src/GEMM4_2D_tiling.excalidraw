    {
      "id": "9t_DMTnjxSoiwPYeBQV_S",
      "type": "text",
      "x": 20,
      "y": 1000,
      "width": 280,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0u",
