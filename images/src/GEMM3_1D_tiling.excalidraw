    {
      "id": "9t_DMTnjxSoiwPYeBQV_S",
      "type": "text",
      "x": 20,
      "y": 1000,
      "width": 280,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0u",
      "roundness": null,
      "seed": 289925588,
      "version": 470,
      "versionNonce": 2125152492,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792051462686,
      "created": 1792037379907,
      "link": null,
      "locked": false,
      "text": "Ads（128×32）：每线程沿 M\n方向取连续 TM=8 行；\nBds（32×128）：每线程沿 N\n方向取连续 TN=8 列。\n\n这两组数据在寄存器里做外积：\n8 个 A 值 × 8 个 B 值 = 64\n次乘加，直接累加到 C 的一个\n8×8 小块里。",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ads（128×32）：每线程沿 M 方向取连续 TM=8 行；\nBds（32×128）：每线程沿 N 方向取连续 TN=8 列。\n\n这两组数据在寄存器里做外积：8 个 A 值 × 8 个 B 值 = 64 次乘加，直接累加到 C 的一个 8×8 小块里。",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
