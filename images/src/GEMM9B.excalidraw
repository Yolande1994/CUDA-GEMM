      "isDeleted": false,
      "boundElements": [],
      "updated": 1792400495293,
      "link": null,
      "locked": false,
      "text": "2. cp.async（LDGSTS）：硬件 DMA 是搬运工，发完指令线程就去计算，硬件自己搬",
      "fontSize": 20,
      "fontFamily": 5,
      "font": "normal",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. cp.async（LDGSTS）：硬件 DMA 是搬运工，发完指令线程就去计算，硬件自己搬",
      "autoResize": true,
