      "isDeleted": false,
      "boundElements": [],
      "updated": 1792400495293,
      "link": null,
      "locked": false,
      "text": "1. 传统 LDG+STS：线程是搬运工，数据必须先经过寄存器中转，线程被占用",
      "fontSize": 20,
      "fontFamily": 5,
      "font": "normal",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 传统 LDG+STS：线程是搬运工，数据必须先经过寄存器中转，线程被占用",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 15.4,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "pbnbxI-g7AIh1x9eyVBB",
      "type": "text",
      "x": 100,
