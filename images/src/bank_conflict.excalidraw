      "isDeleted": true,
      "boundElements": null,
      "updated": 1792230080256,
      "created": 1792229549942,
      "link": null,
      "locked": false,
      "text": "**延迟变成 32 倍**—— 这就是共享内存访问最大的性能杀手。",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**延迟变成 32 倍**—— 这就是共享内存访问最大的性能杀手。",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
