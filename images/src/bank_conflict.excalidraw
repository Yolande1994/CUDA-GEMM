      "version": 154,
      "versionNonce": 1599893230,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792230188890,
      "created": 1792229549941,
      "link": null,
      "locked": false,
      "text": "Bank 0 每周期只能服务 1 个线程，32 个线程要串行 32 次。\n其余 31 个 Bank 全部闲置。延迟变成 32 倍。",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bank 0 每周期只能服务 1 个线程，32 个线程要串行 32 次。\n其余 31 个 Bank 全部闲置。延迟变成 32 倍。",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "oSQwhoMyUMWoIwzt_HvaO",
      "type": "text",
      "x": 2432.8399353027344,
      "y": 840,
      "width": 569.5599975585938,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
