      "text": "所有 32 个线程全部访问 **Bank 0**。",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "所有 32 个线程全部访问 **Bank 0**。",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "WROeE6gB3OxX-YaIOjutp",
      "type": "text",
      "x": 1300,
      "y": 0,
      "width": 600,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
