      "link": null,
      "locked": false,
      "text": "无冲突（理想情况）",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "无冲突（理想情况）",
      "autoResize": true,
