      "isDeleted": true,
      "boundElements": null,
      "updated": 1792229822928,
      "created": 1792229549941,
      "link": null,
      "locked": false,
      "text": "Thread 0 → Bank 0、Thread 1 → Bank 1、……、Thread 7 → Bank 7，每个线程访\n问不同的 Bank。",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Thread 0 → Bank 0、Thread 1 → Bank 1、……、Thread 7 → Bank 7，每个线程访问不同的 Bank。",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
