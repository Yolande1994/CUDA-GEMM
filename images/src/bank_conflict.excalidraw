      "labelPosition": null
    },
    {
      "id": "sJBx5wFUWBE3_U_ESVP7m",
      "type": "text",
      "x": 2324.560089111328,
      "y": 357.49999999999994,
      "width": 786.1196899414062,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
